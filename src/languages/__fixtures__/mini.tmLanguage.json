{
  "name": "Mini SQL (test fixture)",
  "scopeName": "source.mini",
  "patterns": [
    { "include": "#comment" },
    { "match": "(?i)\\b(select|from|where)\\b", "name": "keyword.other.mini" },
    { "match": "\\b\\d+\\b", "name": "constant.numeric.mini" },
    {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.mini",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.mini" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.mini" } }
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.mini"
    }
  ],
  "repository": {
    "comment": { "match": "--.*$", "name": "comment.line.double-dash.mini" }
  }
}
